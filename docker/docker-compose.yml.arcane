services:
  arcane:
    image: ghcr.io/getarcaneapp/arcane:latest
    container_name: arcane
    ports:
      - '3552:3552'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - arcane-data:/app/data
      - /home/enzo/Develop/soft/arcane/app/data/projects:/app/data/projects
    environment:
      - APP_URL=http://localhost:3552
      - PUID=1000
      - PGID=1000
      - ENCRYPTION_KEY=d05c3f72aba30af7a77df3bf3beaae6dc0e1764b9ca5891e91d63c8821553b69
      - JWT_SECRET=48a535c98b3556ae945c6e09c29620296b4ccaf31ce27912816f9c666427b9a6
    restart: unless-stopped

volumes:
  arcane-data: